# wise-writing holds INSTRUCTIONS AND TEMPLATES ONLY — never data, never private
# paths. These rules are a safety net so that research data can never be committed by
# accident. Do not loosen them.

# --- Raw / intermediate data of any kind ---
*.rds
*.rda
*.RData
*.duckdb
*.duckdb.wal
*.sqlite
*.db
*.xml
*.xlsx
*.xls
*.csv
*.tsv
*.parquet
*.feather
*.gpkg
*.shp
*.shx
*.dbf
*.prj

# --- Working directories where data or outputs might land (anchored to the repo root
#     so the project-template/ skeleton is still committed) ---
/data/
/outputs/
/output/
/results/
/private/
/scratch/
/logs/
/figures/

# --- Rendered figures and documents ---
*.png
*.jpg
*.jpeg
*.tif
*.tiff
*.pdf
*.docx

# --- Shipped assets are content, not output. Word reference documents, CSL styles,
#     LaTeX partials and Lua filters live under assets/ and are always tracked. ---
!skills/**/assets/**
!project-template/docs/assets/**

# --- R / RStudio ---
.Rproj.user/
.Rhistory
.RData
.Ruserdata
Rplots.pdf
*.Rproj

# --- Quarto / site build ---
/_site/
/.quarto/
**/.quarto/
*.html
/*_files/
**/*_files/
*.quarto_ipynb

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
